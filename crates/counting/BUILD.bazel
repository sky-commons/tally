load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rustfmt_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

# Test support: a test's allocator. `testonly`, so no production target can depend on it, and the
# crates that hold a key keep `unsafe` out of their own code.
rust_library(
    name = "counting",
    testonly = True,
    srcs = ["src/lib.rs"],
    crate_name = "tally_counting",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = VERSION,
)

rustfmt_test(
    name = "rustfmt",
    testonly = True,
    targets = [":counting"],
)
