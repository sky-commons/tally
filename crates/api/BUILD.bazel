load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "api",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_api",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = VERSION,
    deps = [
        "//crates/api-types",
        "//crates/merge",
        "//crates/relay",
        "//crates/wire",
        "@tally_crates//:axum",
        "@tally_crates//:futures-util",
        "@tally_crates//:h3o",
        "@tally_crates//:http-body-util",
        "@tally_crates//:hyper",
        "@tally_crates//:hyper-util",
        "@tally_crates//:serde",
        "@tally_crates//:serde_json",
        "@tally_crates//:tokio",
        "@tally_crates//:tower",
    ],
)

# Public: what is deployed packs it (the Flightlines repository's images of the public relay).
rust_binary(
    name = "tally-api",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = [
        ":api",
        "@tally_crates//:tokio",
    ],
)

rust_test(
    name = "api_test",
    size = "small",
    crate = ":api",
    edition = "2024",
    lint_config = ":cargo_lints",
)

# A stand-in readsb and a real relay, fed by a receiver over loopback, behind the API; and two
# real engines on the simulator's receivers, publishing through two relays the API merges.
rust_test(
    name = "end_to_end",
    size = "medium",
    srcs = ["tests/end_to_end.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":api",
        "//crates/api-types",
        "//crates/merge",
        "//crates/mlat",
        "//crates/mlat-solver",
        "//crates/relay",
        "//crates/wire",
        "@tally_crates//:axum",
        "@tally_crates//:http-body-util",
        "@tally_crates//:hyper",
        "@tally_crates//:hyper-util",
        "@tally_crates//:serde",
        "@tally_crates//:serde_json",
        "@tally_crates//:tokio",
    ],
)

# `tally-api check` refuses what a start refuses and prints the settings, run against the built
# binary. A deploy checks its own arguments the same way, by asking the API it runs.
rust_test(
    name = "check",
    size = "small",
    srcs = ["tests/check.rs"],
    data = [":tally-api"],
    edition = "2024",
    env = {"TALLY_API_BIN": "$(rootpath :tally-api)"},
    lint_config = ":cargo_lints",
    deps = ["//crates/wire"],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":api",
        ":api_test",
        ":check",
        ":end_to_end",
        ":tally-api",
    ],
)
