load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rustfmt_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

# The solver is numerical code compiled optimised in every build, its tests too, as Cargo does
# (`[profile.dev.package.tally-mlat-solver]` in //:Cargo.toml; BLAKE2s, on its hot path, is
# optimised by an annotation in //:tally.MODULE.bazel): unoptimised, the engine tests'
# thousands of solves take six minutes of CPU where optimised they take thirteen seconds of wall
# time, and every engine test that solves pays the same. Debug assertions and overflow checks stay
# as the build has them. The results are the same to the bit at either level (no fused
# multiply-add, `libm` for transcendentals; the golden test holds a model's bytes either way).
SOLVER_RUSTC_FLAGS = ["-Copt-level=2"]

rust_library(
    name = "mlat-solver",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tally_mlat_solver",
    edition = "2024",
    lint_config = ":cargo_lints",
    rustc_flags = SOLVER_RUSTC_FLAGS,
    version = VERSION,
    deps = [
        "//crates/wire",
        "@tally_crates//:blake2",
        "@tally_crates//:libm",
        "@tally_crates//:thiserror",
    ],
)

# Every engine test runs the engine as the crate docs specify it (every area refitted every
# `REFIT_EVERY` over its trailing window, what is due solved every second under its cited area's
# model). The sweep is an ignored test.
rust_test(
    name = "mlat-solver_test",
    size = "medium",
    crate = ":mlat-solver",
    edition = "2024",
    lint_config = ":cargo_lints",
    rustc_flags = SOLVER_RUSTC_FLAGS,
)

# The pool's byte accounting (`arrived::Arrived`) against an allocator that counts every byte
# (RFC-0181 §5): a binary of its own, since a counting allocator is global and nothing else may
# allocate while it measures.
rust_test(
    name = "arrived_bytes",
    size = "small",
    srcs = ["tests/arrived_bytes.rs"],
    crate_root = "tests/arrived_bytes.rs",
    edition = "2024",
    lint_config = ":cargo_lints",
    rustc_flags = SOLVER_RUSTC_FLAGS,
    deps = [
        ":mlat-solver",
        "//crates/counting",
        "//crates/wire",
    ],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":arrived_bytes",
        ":mlat-solver",
        ":mlat-solver_test",
    ],
)
