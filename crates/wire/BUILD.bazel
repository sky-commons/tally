load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test", "rustfmt_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "wire",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tally_wire",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = VERSION,
    deps = [
        "@tally_crates//:base64",
        "@tally_crates//:blake2",
        "@tally_crates//:bytes",
        "@tally_crates//:ed25519-dalek",
        "@tally_crates//:getrandom",
        "@tally_crates//:h3o",
        "@tally_crates//:libc",
        "@tally_crates//:miniz_oxide",
        "@tally_crates//:serde",
        "@tally_crates//:serde_json",
        "@tally_crates//:snow",
        "@tally_crates//:thiserror",
        "@tally_crates//:tokio",
    ],
)

rust_test(
    name = "wire_test",
    size = "small",
    crate = ":wire",
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = ["//crates/counting"],
)

# What `footprint` says each collection allocates is what it allocates, measured by an allocator
# that counts every byte, the only test in its binary so nothing else allocates while it measures.
rust_test(
    name = "footprint_bytes",
    size = "small",
    srcs = ["tests/footprint_bytes.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":wire",
        "//crates/counting",
    ],
)

# The doc examples, which are the compile-fail checks of what the types refuse: an `Identity`
# cannot be cloned, a `Signing` cannot be kept past its call, and a handshake's key cannot sign.
rust_doc_test(
    name = "wire_doc_test",
    size = "small",
    crate = ":wire",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":footprint_bytes",
        ":wire",
        ":wire_test",
    ],
)
