load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "feed",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    # The release's seed list, compiled in (`config::SEEDS`).
    compile_data = ["//packaging:seeds"],
    crate_name = "tally_feed",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = VERSION,
    deps = [
        "//crates/wire",
        "@tally_crates//:getrandom",
        "@tally_crates//:libc",
        "@tally_crates//:tokio",
    ],
)

rust_binary(
    name = "tally-feed",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = VERSION,
    deps = [
        ":feed",
        "@tally_crates//:tokio",
    ],
)

rust_test(
    name = "feed_test",
    size = "small",
    # Real decoders' lines, which src/acars.rs's tests read (`include_str!`).
    compile_data = glob(["testdata/**"]),
    crate = ":feed",
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = ["@tally_crates//:serde_json"],
)

# The packaged unit's seccomp filter, held to the system calls the host clock's read makes.
rust_test(
    name = "unit",
    size = "small",
    srcs = ["tests/unit.rs"],
    data = ["//packaging/systemd:tally-feed.service"],
    edition = "2024",
    env = {"TALLY_FEED_UNIT": "$(rootpath //packaging/systemd:tally-feed.service)"},
    lint_config = ":cargo_lints",
    deps = ["//crates/wire"],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":feed",
        ":feed_test",
        ":tally-feed",
        ":unit",
    ],
)
