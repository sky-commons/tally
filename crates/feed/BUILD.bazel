load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "feed",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_feed",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//crates/wire",
        "@tally_crates//:getrandom",
        "@tally_crates//:tokio",
    ],
)

rust_binary(
    name = "tally-feed",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        ":feed",
        "@tally_crates//:tokio",
    ],
)

rust_test(
    name = "feed_test",
    size = "small",
    crate = ":feed",
    edition = "2024",
    lint_config = ":cargo_lints",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":feed",
        ":feed_test",
        ":tally-feed",
    ],
)
