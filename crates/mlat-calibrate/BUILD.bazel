load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "mlat-calibrate",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_mlat_calibrate",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//crates/mlat",
        "//crates/mlat-solver",
        "//crates/wire",
        "@tally_crates//:blake2",
    ],
)

# The calibration itself: `bazel run -c opt //crates/mlat-calibrate:tally-mlat-calibrate -- <subset dir>` over a
# LocaRDS subset fetched by `fetch.sh` (the crate documentation says what it measures). Not a
# test: it reads a 1.2 GB dataset the build does not hold, and replays an hour of Europe through
# the engine.
rust_binary(
    name = "tally-mlat-calibrate",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [":mlat-calibrate"],
)

rust_test(
    name = "mlat-calibrate_test",
    size = "medium",
    crate = ":mlat-calibrate",
    edition = "2024",
    lint_config = ":cargo_lints",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":mlat-calibrate",
        ":mlat-calibrate_test",
    ],
)
