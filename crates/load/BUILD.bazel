load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "load",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_load",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = VERSION,
    deps = [
        "//crates/feed",
        "//crates/mlat-solver",
        "//crates/relay",
        "//crates/wire",
        "@tally_crates//:clock-bound-shm",
        "@tally_crates//:libc",
        "@tally_crates//:nix",
        "@tally_crates//:serde_json",
        "@tally_crates//:tokio",
    ],
)

# An operational tool, run by name: `bazel run -c opt //crates/load:tally-load -- --help`.
# It starts the relay built beside it (TALLY_RELAY) unless told of one already running. Run it
# optimised: a debug relay and debug feeders measure the build, not the relay.
rust_binary(
    name = "tally-load",
    srcs = ["src/main.rs"],
    data = ["//crates/relay:tally-relay"],
    edition = "2024",
    env = {"TALLY_RELAY": "$(rootpath //crates/relay:tally-relay)"},
    lint_config = ":cargo_lints",
    version = VERSION,
    deps = [
        ":load",
        "@tally_crates//:tokio",
    ],
)

# The simulation is built optimised by the solver's own flags, so this stays small.
rust_test(
    name = "load_test",
    size = "small",
    crate = ":load",
    edition = "2024",
    lint_config = ":cargo_lints",
)

# The public relay's plan against what it is resident at 0, 8, 32 and 128 feeders, at its deployed
# arguments (`public_relay`) and again gathering the world products (`public_relay_world`), each
# its own target so each run of four loads fits a large test's time (RFC-0181, "Sizing"): a
# measurement of this host, minutes long, so `manual` and never in the verdict.
# `bazel test -c opt //crates/load:public_relay //crates/load:public_relay_world --test_output=all`.
[
    rust_test(
        name = name,
        size = "large",
        srcs = ["tests/public_relay.rs"],
        args = [test],
        data = ["//crates/relay:tally-relay"],
        edition = "2024",
        env = {"TALLY_RELAY": "$(rootpath //crates/relay:tally-relay)"},
        lint_config = ":cargo_lints",
        tags = ["manual"],
        deps = [
            ":load",
            "//crates/wire",
            "@tally_crates//:tokio",
        ],
    )
    for name, test in [
        ("public_relay", "the_public_relay_is_resident_within_its_plan_at_each_load"),
        (
            "public_relay_world",
            "the_public_relay_gathering_the_world_is_resident_within_its_plan_at_each_load",
        ),
    ]
]

# The world relay's planned MLAT seats against what 2,000 feeders settle it at on its 16 cores,
# within 15% (`tests/plan_seats.rs`, RFC-0181 §10, "MLAT in the cores"): a measurement of this
# host, minutes long and over 17 cores at least, so `manual` and never in the verdict.
# `bazel test -c opt //crates/load:plan_seats --test_output=all --test_arg=--nocapture`.
rust_test(
    name = "plan_seats",
    size = "large",
    srcs = ["tests/plan_seats.rs"],
    data = ["//crates/relay:tally-relay"],
    edition = "2024",
    env = {"TALLY_RELAY": "$(rootpath //crates/relay:tally-relay)"},
    lint_config = ":cargo_lints",
    tags = ["manual"],
    deps = [
        ":load",
        "//crates/relay",
        "@tally_crates//:tokio",
    ],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":load",
        ":load_test",
        ":plan_seats",
        ":public_relay",
        ":public_relay_world",
        ":tally-load",
    ],
)
