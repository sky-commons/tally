load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//tally:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//tally:Cargo.toml",
)

rust_library(
    name = "mlat",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_mlat",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//tally/crates/wire",
        "@tally_crates//:getrandom",
        "@tally_crates//:serde_json",
        "@tally_crates//:tokio",
    ],
)

rust_binary(
    name = "tally-mlat",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        ":mlat",
        "@tally_crates//:tokio",
    ],
)

rust_test(
    name = "mlat_test",
    size = "small",
    crate = ":mlat",
    edition = "2024",
    lint_config = ":cargo_lints",
)

# A stand-in relay and a stand-in mlat-server around a real engine, over loopback sockets.
rust_test(
    name = "end_to_end",
    size = "medium",
    srcs = [
        "tests/end_to_end.rs",
        "tests/support/mod.rs",
    ],
    crate_root = "tests/end_to_end.rs",
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":mlat",
        "//tally/crates/wire",
        "@tally_crates//:serde_json",
        "@tally_crates//:tokio",
    ],
)

# The same engine and stand-in mlat-server against a real relay, with a feeder and a positions
# subscriber on it.
rust_test(
    name = "real_relay",
    size = "medium",
    srcs = [
        "tests/real_relay.rs",
        "tests/support/mod.rs",
    ],
    crate_root = "tests/real_relay.rs",
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":mlat",
        "//tally/crates/relay",
        "//tally/crates/wire",
        "@tally_crates//:serde_json",
        "@tally_crates//:tokio",
    ],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":end_to_end",
        ":mlat",
        ":mlat_test",
        ":real_relay",
        ":tally-mlat",
    ],
)
