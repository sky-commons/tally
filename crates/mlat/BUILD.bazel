load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//tally:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//tally:Cargo.toml",
)

rust_library(
    name = "mlat",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_mlat",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:h3o",
        "@tally_crates//:libm",
    ],
)

rust_test(
    name = "mlat_test",
    size = "medium",
    crate = ":mlat",
    edition = "2024",
    lint_config = ":cargo_lints",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":mlat",
        ":mlat_test",
    ],
)
