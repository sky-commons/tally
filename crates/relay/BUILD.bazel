load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//tally:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//tally:Cargo.toml",
)

rust_library(
    name = "relay",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_relay",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

rust_binary(
    name = "tally-relay",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        ":relay",
        "@tally_crates//:tokio",
    ],
)

# A stand-in readsb, a real feeder, this relay and its subscribers, over loopback sockets.
rust_test(
    name = "end_to_end",
    size = "medium",
    srcs = ["tests/end_to_end.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//tally/crates/feed",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":end_to_end",
        ":relay",
        ":tally-relay",
    ],
)
