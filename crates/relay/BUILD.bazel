load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//build:opt.bzl", "opt_test")
load("//build:resources.bzl", "test_size")

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "relay",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_relay",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//crates/mlat",
        "//crates/mlat-solver",
        "//crates/wire",
        "@tally_crates//:axum",
        "@tally_crates//:libc",
        "@tally_crates//:serde",
        "@tally_crates//:tokio",
    ],
)

# Public: an operator packs it and checks its deploy against it (`tally-relay check`).
rust_binary(
    name = "tally-relay",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [
        ":relay",
        "//crates/wire",
        "@tally_crates//:tokio",
    ],
)

# Medium: 12 s on 32 loaded cores here, past small's 60 s on one remote core (2026-10-07).
rust_test(
    name = "relay_test",
    size = "medium",
    crate = ":relay",
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = ["@tally_crates//:serde_json"],
)

# A stand-in readsb, a real feeder, this relay and its subscribers, over loopback sockets.
rust_test(
    name = "end_to_end",
    size = "medium",
    srcs = ["tests/end_to_end.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//crates/feed",
        "//crates/mlat-solver",
        "//crates/wire",
        "@tally_crates//:tokio",
    ],
)

# The staged relay's invariants (RFC-0181) on its own threads: the same stamped trace makes the
# same bytes on 1, 2 and 8 threads (products and stream), batches stamped by the relay's own clock
# with delays inside every stage make the same bytes as with none, a message is kept once a window
# (copies up to two seconds apart are one), each receiver's batches reach a subscriber in order,
# and what is let go is let go whole.
rust_test(
    name = "staged",
    size = "medium",
    srcs = ["tests/staged.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//crates/mlat-solver",
        "//crates/wire",
        "@tally_crates//:tokio",
    ],
)

# RFC-0181 invariant 8, two tests. Over real sockets: four times the feeders the budget admits
# connect at once, exactly the ceiling is admitted, and while those flood and a subscriber never
# reads, every decoded batch alive is charged by the store holding it, read at the same instant
# (`Budget::decoded_held`), and the batch byte store and the delivery tags hold no more than they are
# charged; a holder seen uncharged in every sample for 100 ms fails it, and the watch is first shown
# to see one. On the hub alone: a stage that stalls (an epoch that never closes, a subscriber that
# never reads) refuses what passes its share, holds nothing uncharged, and lets it all go when the
# epoch closes. Their own binary, one at a time: they measure the process's decoded batches.
rust_test(
    name = "flood",
    size = "medium",
    srcs = ["tests/flood.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//crates/wire",
        "@tally_crates//:tokio",
    ],
)

# The relay's one panic mechanism (`tally_relay::abort_on_any_panic`): a panicking tokio task or
# thread ends the process, each case the test binary run again as the process that panics; and the
# relay program's `main` sets it, the built binary made to panic as it reads its arguments.
rust_test(
    name = "panic",
    size = "small",
    srcs = ["tests/panic.rs"],
    data = [":tally-relay"],
    edition = "2024",
    env = {"TALLY_RELAY_BIN": "$(rootpath :tally-relay)"},
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "@tally_crates//:tokio",
    ],
)

# The same invariants for the hosted MLAT (RFC-0181 §3, §5, §9): the same stamped trace makes the
# same clock models, positions and provisional positions on any number of threads, and at
# capacity the same receivers are refused whole whatever the order.
rust_test(
    name = "staged_mlat",
    size = "medium",
    srcs = ["tests/staged_mlat.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//crates/mlat",
        "//crates/mlat-solver",
        "//crates/wire",
        "@tally_crates//:tokio",
    ],
)

# Each test of the binary is its own target, so each runs alone and declares what it alone needs,
# measured (2026-10-08, release build, `/usr/bin/time -v`, each test alone): the three
# single-network tests are a relay or two over a 45 s scenario (60 s: models ripen
# 15 s after their window step), the relays' clock walking it a step at a time (`TestClock`): at most 25 MiB resident and under a second of CPU each, up to 16 s (the
# first waits for a window to come due). The three-relay test runs three relays through 2.5 min of
# scenario: 76 MiB resident, 6 s of CPU in 150 s. The four-relay test waits out a dead relay's
# offers (`directory::OFFER_LIFETIME_MS`, 3 min), its relays idle. Each declared at twice its
# resident peak or more and a core or two, to the local scheduler and the remote one alike
# (//build:resources.bzl); the binary's two threads of tokio and the hosts' solver threads
# run in short bursts.
_MLAT_HOST_TESTS = {
    "mlat_host_feeders": (
        "feeders_of_a_relay_hosting_mlat_give_its_clients_verifiable_positions_and_provisionals",
        "medium",
        test_size(
            cpu = 2,
            memory_mb = 256,
        ),
    ),
    "mlat_host_seed_53": (
        "every_final_a_relay_publishes_passes_the_verifier_seed_53",
        "small",
        test_size(
            cpu = 2,
            memory_mb = 256,
        ),
    ),
    "mlat_host_one_hop": (
        "raw_from_a_relay_that_solves_nothing_reaches_the_relay_that_solves_its_area_in_one_hop",
        "small",
        test_size(
            cpu = 2,
            memory_mb = 256,
        ),
    ),
    "mlat_host_three_relays": (
        "three_relays_share_solve_and_serve_verifiable_positions_and_both_world_products",
        "large",
        test_size(
            cpu = 2,
            memory_mb = 512,
        ),
    ),
    "mlat_host_four_relays": (
        "of_four_relays_three_solve_an_area_and_a_dead_one_is_replaced_by_the_next",
        "large",
        test_size(
            cpu = 2,
            memory_mb = 512,
        ),
    ),
}

# One program: the simulator's receivers feed a relay hosting MLAT (and, apart, a relay that
# passes their raw one hop to it), and a client verifies what it publishes; then three relays as
# RFC-0174 runs them, with sharing, selection and both world products (about 3 minutes: the
# precise world seals a second 90 s after it). The relays' clock walks a scenario no faster than
# they keep up and no faster than the wall clock, whose pace a debug build cannot keep, so the
# binary is built optimised (`mlat_host_*`, below) and runs only so.
rust_test(
    name = "mlat_host_binary",
    srcs = ["tests/mlat_host.rs"],
    crate_root = "tests/mlat_host.rs",
    edition = "2024",
    lint_config = ":cargo_lints",
    # The tests the targets below run, one each: the binary checks they are exactly its own
    # (`every_test_has_one_target`), so a test renamed, added or removed fails every target
    # rather than leave one running nothing, green.
    rustc_env = {
        "MLAT_HOST_TESTS": " ".join([test for test, _, _ in _MLAT_HOST_TESTS.values()]),
    },
    # Run through `mlat_host_*`, built optimised; never on its own at the command line's mode.
    tags = ["manual"],
    deps = [
        ":relay",
        "//crates/mlat",
        "//crates/mlat-solver",
        "//crates/wire",
        "@tally_crates//:tokio",
    ],
)

[
    opt_test(
        name = name,
        size = size,
        # Its test by exact name, and the guard that every test here is one target's: libtest
        # runs nothing, green, for a name it lacks, and the guard fails then.
        args = [
            "--exact",
            test,
            "every_test_has_one_target",
            "--test-threads=1",
        ],
        exec_properties = resources.exec_properties,
        tags = resources.tags,
        test = ":mlat_host_binary",
    )
    for name, (test, size, resources) in _MLAT_HOST_TESTS.items()
]

# `tally-relay check` refuses what a start refuses and prints the memory plan (RFC-0181 §9), run
# against the built binary with the test's own arguments and with the packaged unit's: what Tally
# publishes starts a relay that admits feeders. An operator checks its own deploy the same way, by
# asking the relay it runs (RFC-0180 §3).
rust_test(
    name = "check",
    size = "small",
    srcs = ["tests/check.rs"],
    # The cores' plan RFC-0181 quotes, which the test holds equal to what the relay prints.
    compile_data = ["tests/cores-10.txt"],
    data = [
        ":tally-relay",
        "//packaging/systemd:tally-relay.service",
    ],
    edition = "2024",
    env = {
        "TALLY_RELAY_BIN": "$(rootpath :tally-relay)",
        "TALLY_RELAY_UNIT": "$(rootpath //packaging/systemd:tally-relay.service)",
    },
    lint_config = ":cargo_lints",
    # A member link's share (`peers::WAITING_PER_LINK_BYTES`), which the plan's line is made of.
    deps = [":relay"],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":check",
        ":end_to_end",
        ":flood",
        ":mlat_host_binary",
        ":panic",
        ":relay",
        ":relay_test",
        ":staged",
        ":staged_mlat",
        ":tally-relay",
    ],
)
