load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//tally/build:opt.bzl", "opt_test")

package(default_visibility = ["//tally:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//tally:Cargo.toml",
)

rust_library(
    name = "relay",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_relay",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//tally/crates/mlat",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:axum",
        "@tally_crates//:libc",
        "@tally_crates//:serde",
        "@tally_crates//:tokio",
    ],
)

# Public: an operator packs it and checks its deploy against it (`tally-relay check`).
rust_binary(
    name = "tally-relay",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [
        ":relay",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# Medium: 12 s on 32 loaded cores here, past small's 60 s on one remote core (2026-10-07).
rust_test(
    name = "relay_test",
    size = "medium",
    crate = ":relay",
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = ["@tally_crates//:serde_json"],
)

# A stand-in readsb, a real feeder, this relay and its subscribers, over loopback sockets.
rust_test(
    name = "end_to_end",
    size = "medium",
    srcs = ["tests/end_to_end.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//tally/crates/feed",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# The staged relay's invariants (RFC-0181) on its own threads: the same stamped trace makes the
# same bytes on 1, 2 and 8 threads (products and stream), batches stamped by the relay's own clock
# with delays inside every stage make the same bytes as with none, a message is kept once a window
# (copies up to two seconds apart are one), each receiver's batches reach a subscriber in order,
# and what is let go is let go whole.
rust_test(
    name = "staged",
    size = "medium",
    srcs = ["tests/staged.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# The same invariants for the hosted MLAT (RFC-0181 §3, §5, §9): the same stamped trace makes the
# same clock models, positions and provisional positions on any number of threads, and at
# capacity the same receivers are refused whole whatever the order.
rust_test(
    name = "staged_mlat",
    size = "medium",
    srcs = ["tests/staged_mlat.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//tally/crates/mlat",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# One program: the simulator's receivers feed a relay hosting MLAT (and, apart, a relay that
# passes their raw one hop to it), and a client verifies what it publishes; then three relays as
# RFC-0174 runs them, with sharing, selection and both world products (about 3 minutes: the
# precise world seals a second 90 s after it). The relays run in real time, which a debug build
# cannot keep up with, so the binary is built optimised (`mlat_host`, below) and runs only so.
rust_test(
    name = "mlat_host_binary",
    srcs = ["tests/mlat_host.rs"],
    crate_root = "tests/mlat_host.rs",
    edition = "2024",
    lint_config = ":cargo_lints",
    # Run through `mlat_host`, built optimised; never on its own at the command line's mode.
    tags = ["manual"],
    deps = [
        ":relay",
        "//tally/crates/mlat",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# What it needs, measured (2026-10-07, release build, the three-relay test alone): 276 s of CPU in
# 183 s, 1.5 cores on average, with three hosted engines of two solver threads each stepping at
# once (six threads at the peak) beside the eight-thread runtime; 425 MiB resident. Declared as 4
# cores and 1 GiB, to the local scheduler (`resources:` tags) and the remote one (`test.` exec
# properties), as //tools/build/platforms:resources.bzl declares a test's size.
opt_test(
    name = "mlat_host",
    size = "large",
    exec_properties = {
        "test.cpu_count": "4",
        "test.memory_mb": "1024",
    },
    tags = [
        "resources:cpu:4",
        "resources:memory:1024",
    ],
    test = ":mlat_host_binary",
)

# `tally-relay check` refuses what a start refuses and prints the memory plan (RFC-0181 §9), run
# against the built binary with the test's own arguments and with the packaged unit's: what Tally
# publishes starts a relay that admits feeders. An operator checks its own deploy the same way, by
# asking the relay it runs (RFC-0180 §3).
rust_test(
    name = "check",
    size = "small",
    srcs = ["tests/check.rs"],
    data = [
        ":tally-relay",
        "//tally/packaging/systemd:tally-relay.service",
    ],
    edition = "2024",
    env = {
        "TALLY_RELAY_BIN": "$(rootpath :tally-relay)",
        "TALLY_RELAY_UNIT": "$(rootpath //tally/packaging/systemd:tally-relay.service)",
    },
    lint_config = ":cargo_lints",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":check",
        ":end_to_end",
        ":mlat_host_binary",
        ":relay",
        ":relay_test",
        ":staged",
        ":staged_mlat",
        ":tally-relay",
    ],
)
