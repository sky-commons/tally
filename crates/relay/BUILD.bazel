load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//tally/build:opt.bzl", "opt_test")

package(default_visibility = ["//tally:__subpackages__"])

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//tally:Cargo.toml",
)

rust_library(
    name = "relay",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "tally_relay",
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    deps = [
        "//tally/crates/mlat",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:axum",
        "@tally_crates//:libc",
        "@tally_crates//:serde",
        "@tally_crates//:tokio",
    ],
)

# Public: what is deployed packs it (the Flightlines repository's images of the public relay).
rust_binary(
    name = "tally-relay",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [
        ":relay",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# Medium: 12 s on 32 loaded cores here, past small's 60 s on one remote core (2026-10-07).
rust_test(
    name = "relay_test",
    size = "medium",
    crate = ":relay",
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = ["@tally_crates//:serde_json"],
)

# A stand-in readsb, a real feeder, this relay and its subscribers, over loopback sockets.
rust_test(
    name = "end_to_end",
    size = "medium",
    srcs = ["tests/end_to_end.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//tally/crates/feed",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# The staged relay's invariants (RFC-0177) on its own threads: the same stamped trace makes the
# same bytes on 1, 2 and 8 threads (products, stream and hosted MLAT), delays change nothing, a message is kept once a window, each
# receiver's batches reach a subscriber in order, and what is let go is let go whole.
rust_test(
    name = "staged",
    size = "medium",
    srcs = ["tests/staged.rs"],
    edition = "2024",
    lint_config = ":cargo_lints",
    deps = [
        ":relay",
        "//tally/crates/mlat",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# One program: the simulator's receivers feed a relay hosting MLAT (and, apart, a relay that
# passes their raw one hop to it), and a client verifies what it publishes; then three relays as
# RFC-0174 runs them, with sharing, selection and both world products (about 3 minutes: the
# precise world seals a second 90 s after it). The relays run in real time, which a debug build
# cannot keep up with, so the binary is built optimised (`mlat_host`, below) and runs only so.
rust_test(
    name = "mlat_host_binary",
    srcs = ["tests/mlat_host.rs"],
    crate_root = "tests/mlat_host.rs",
    edition = "2024",
    lint_config = ":cargo_lints",
    # Run through `mlat_host`, built optimised; never on its own at the command line's mode.
    tags = ["manual"],
    deps = [
        ":relay",
        "//tally/crates/mlat",
        "//tally/crates/mlat-solver",
        "//tally/crates/wire",
        "@tally_crates//:tokio",
    ],
)

# What it needs, measured (2026-10-07, release build, the three-relay test alone): 276 s of CPU in
# 183 s, 1.5 cores on average, with three hosted engines of two solver threads each stepping at
# once (six threads at the peak) beside the eight-thread runtime; 425 MiB resident. Declared as 4
# cores and 1 GiB, to the local scheduler (`resources:` tags) and the remote one (`test.` exec
# properties), as //tools/build/platforms:resources.bzl declares a test's size.
opt_test(
    name = "mlat_host",
    size = "large",
    exec_properties = {
        "test.cpu_count": "4",
        "test.memory_mb": "1024",
    },
    tags = [
        "resources:cpu:4",
        "resources:memory:1024",
    ],
    test = ":mlat_host_binary",
)

# Every deployed relay's configuration admits feeders (RFC-0177 §9): its arguments through the
# relay's own parser, its memory as the relay finds it, its budget as `main` builds it.
rust_test(
    name = "deployed",
    size = "small",
    srcs = ["tests/deployed.rs"],
    data = [
        "//infra/prod-host:tally/units/tally-relay.service",
        "//tally/packaging/systemd:tally-relay.service",
    ],
    edition = "2024",
    env = {
        "TALLY_RELAY_DEPLOYED": "$(rootpaths //infra/prod-host:tally/units/tally-relay.service) $(rootpaths //tally/packaging/systemd:tally-relay.service)",
    },
    lint_config = ":cargo_lints",
    deps = [":relay"],
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":deployed",
        ":end_to_end",
        ":mlat_host_binary",
        ":relay",
        ":relay_test",
        ":staged",
        ":tally-relay",
    ],
)
