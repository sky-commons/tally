load("@rules_rust//rust:defs.bzl", "rust_test", "rustfmt_test")

# The feeder's installer, for an operator's check of the seed list it ships (`install.sh
# --check-seeds FILE`, which reads a seed list as an install does), and its updater.
exports_files([
    "install.sh",
    "update.sh",
])

# The release's seed list, which the feeder compiles in (`crates/feed`, `config::SEEDS`) and the
# release publishes beside the binaries for the installer: one list.
exports_files(
    ["seeds"],
    visibility = ["//crates/feed:__pkg__"],
)

# The geoid grid the release publishes (geoid.txt.gz) for the installer, which the feeder compiles
# in too (`crates/feed`, `geoid`), so `ALT_MSL` and `--alt-msl` convert as the installer does.
exports_files(
    ["geoid/geoid.txt"],
    visibility = ["//crates/feed:__pkg__"],
)

# The installer and the updater (`update.sh`, RFC-0203), each behaviour sourced into a sandbox
# with its paths moved and the commands it calls stubbed (tests/sandbox).
rust_test(
    name = "install_test",
    size = "small",
    srcs = [
        "tests/install.rs",
        "tests/sandbox/mod.rs",
    ],
    crate_root = "tests/install.rs",
    data = [
        "geoid/geoid.txt",
        "install.sh",
        "update.sh",
    ],
    edition = "2024",
    env = {
        "TALLY_GEOID": "$(rootpath geoid/geoid.txt)",
        "TALLY_INSTALLER": "$(rootpath install.sh)",
        "TALLY_UPDATER": "$(rootpath update.sh)",
    },
)

# The installs of the releases before this one, as they published them (release.yml checks that).
filegroup(
    name = "previous_releases",
    srcs = glob(["tests/previous/**"]),
)

# The upgrade gate (RFC-0203 §4): every earlier install, vendored in tests/previous, and this
# build's own, upgrades to this build by itself, through its own updater or the owner's rerun,
# to the real feeder, which starts with the key and the settings it had.
rust_test(
    name = "upgrade_test",
    size = "small",
    srcs = [
        "tests/sandbox/mod.rs",
        "tests/upgrade.rs",
    ],
    crate_root = "tests/upgrade.rs",
    data = [
        "geoid/geoid.txt",
        "install.sh",
        "update.sh",
        ":previous_releases",
        "//crates/feed:tally-feed",
        "//packaging/systemd:tally-feed.service",
        "//packaging/systemd:tally-feed-update.service",
        "//packaging/systemd:tally-feed-update.timer",
    ],
    edition = "2024",
    env = {
        "TALLY_FEED": "$(rootpath //crates/feed:tally-feed)",
        "TALLY_GEOID": "$(rootpath geoid/geoid.txt)",
        "TALLY_INSTALLER": "$(rootpath install.sh)",
        "TALLY_PREVIOUS": "$(rootpaths :previous_releases)",
        "TALLY_UNIT_tally_feed_service": "$(rootpath //packaging/systemd:tally-feed.service)",
        "TALLY_UNIT_tally_feed_update_service": "$(rootpath //packaging/systemd:tally-feed-update.service)",
        "TALLY_UNIT_tally_feed_update_timer": "$(rootpath //packaging/systemd:tally-feed-update.timer)",
        "TALLY_UPDATER": "$(rootpath update.sh)",
    },
)

# The map image's archiver packing a day's ACARS lines (packaging/map/entrypoint.sh archive-pass),
# with the image's tally-acars-collect, from the time the collector stops writing a day. The
# script runs on the host's bash, coreutils, findutils, tar and gzip, as the image's Debian has
# them (the test's `TOOLS`, each checked on PATH first).
rust_test(
    name = "map_archive_test",
    size = "small",
    srcs = ["tests/map_archive.rs"],
    data = [
        "map/entrypoint.sh",
        "//crates/acars-collect:tally-acars-collect",
    ],
    edition = "2024",
    deps = ["//crates/acars-collect"],
    env = {
        "TALLY_ACARS_COLLECT": "$(rootpath //crates/acars-collect:tally-acars-collect)",
        "TALLY_MAP_ENTRYPOINT": "$(rootpath map/entrypoint.sh)",
    },
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":install_test",
        ":map_archive_test",
        ":upgrade_test",
    ],
)
