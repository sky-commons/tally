load("@rules_rust//rust:defs.bzl", "rust_test", "rustfmt_test")

# The feeder's installer, for an operator's check of the seed list it ships (`install.sh
# --check-seeds FILE`, which reads a seed list as an install does).
exports_files(["install.sh"])

# The release's seed list, which the feeder compiles in (`crates/feed`, `config::SEEDS`) and the
# release publishes beside the binaries for the installer: one list.
exports_files(
    ["seeds"],
    visibility = ["//crates/feed:__pkg__"],
)

# Until a release pipeline publishes Tally's releases (RFC-0180 phase 1), the installer names no
# release and no seed list: it stops saying how to pass both (`TALLY_RELEASE`, `TALLY_SEEDS`).
rust_test(
    name = "install_test",
    size = "small",
    srcs = ["tests/install.rs"],
    data = ["install.sh"],
    edition = "2024",
    env = {"TALLY_INSTALLER": "$(rootpath install.sh)"},
)

# The map image's archiver packing a day's ACARS lines (packaging/map/entrypoint.sh archive-pass),
# with the image's tally-acars-collect, from the time the collector stops writing a day. The
# script runs on the host's bash, coreutils, findutils, tar and gzip, as the image's Debian has
# them (the test's `TOOLS`, each checked on PATH first).
rust_test(
    name = "map_archive_test",
    size = "small",
    srcs = ["tests/map_archive.rs"],
    data = [
        "map/entrypoint.sh",
        "//crates/acars-collect:tally-acars-collect",
    ],
    edition = "2024",
    deps = ["//crates/acars-collect"],
    env = {
        "TALLY_ACARS_COLLECT": "$(rootpath //crates/acars-collect:tally-acars-collect)",
        "TALLY_MAP_ENTRYPOINT": "$(rootpath map/entrypoint.sh)",
    },
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":install_test",
        ":map_archive_test",
    ],
)
