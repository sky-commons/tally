# The Tally feeder (RFC-0171 §3.5): reads this receiver's own decoders and publishes what they heard
# to a few Tally relays. It only connects out: it listens on no port and takes no orders from the
# network. Its arguments are in /etc/default/tally-feed: TALLY_FEED_ARGS, the block install.sh
# rewrites on every run (the relays, the location and how exactly it is published, the UAT
# source), then TALLY_FEED_EXTRA, the owner's own flags, which install.sh keeps; a flag given once
# (--lat, --precision) is the last one's, so the owner's wins. `tally-feed --help` lists them.
#
# Needs systemd 247 or later (LoadCredential= and $CREDENTIALS_DIRECTORY, both new in 247; the %d
# specifier for the same directory is 248's, so it is not used). SocketBindDeny= is 249's: an
# older systemd logs that it does not know it and runs the unit without it, the feeder still
# opening no listening socket of its own.

# The host's time daemon must be chrony or ntpd (install.sh installs chrony when it has neither,
# and starts one installed and stopped): the feeder trusts its host's clock only by the kernel's
# error bound (maxerror), which each of them keeps true. systemd-timesyncd keeps none: it sets the
# bound to zero at a sync and the kernel grows it 500 us a second from there, which can stand below
# the clock's real error, so under timesyncd the bound understates it and neither the kernel nor
# the feeder can tell (RFC-0171 §3.6). Nothing here tells one daemon from another, so the
# requirement is stated. The feeder starts after chrony-wait.service (chrony's own wait for a
# synchronised clock, which it pulls in) and after time-sync.target, which it never pulls in
# (systemd.special(7): a unit that needs the time is ordered after it "but not pull it in"). That
# target holds the start back only while a wait service is enabled (under ntpd, ntpsec-wait.service
# or systemd-time-wait-sync.service); with none it is reached at once. What holds either way is the
# kernel's word, read at each judgement: until it says synchronised, the host is no clock source.

[Unit]
Description=Tally feeder: publishes this receiver's receptions to Tally relays
Documentation=https://github.com/sky-commons/tally
After=network-online.target chrony-wait.service time-sync.target
Wants=network-online.target chrony-wait.service

[Service]
Type=simple
EnvironmentFile=/etc/default/tally-feed
# The key stays root's, mode 600. systemd reads it and hands the service a private copy in its
# credentials directory ($CREDENTIALS_DIRECTORY), so the dynamic user never needs access to
# /etc/tally. ${NAME} is one word and $NAME splits on whitespace, an unset one giving none.
LoadCredential=key:/etc/tally/key
ExecStart=/usr/local/bin/tally-feed --key ${CREDENTIALS_DIRECTORY}/key --state /var/lib/tally-feed $TALLY_FEED_ARGS $TALLY_FEED_EXTRA
Restart=always
RestartSec=10

DynamicUser=yes
StateDirectory=tally-feed
StateDirectoryMode=0700
ConfigurationDirectory=tally
UMask=0077

# A small, outbound-only process: it may connect to the decoders and to relays, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# No ProtectClock=: it filters adjtimex(2) whole, and the feeder reads the host clock's error
# bound with it (a read, no modes set), which is how it knows whether its own clock is a source it
# may trust (RFC-0171 §3.6). The clock cannot be set from here all the same: the empty
# CapabilityBoundingSet below keeps CAP_SYS_TIME out, and the kernel refuses a write without it.
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# @resources stays allowed: the async runtime may set a thread's affinity or priority.
SystemCallFilter=~@privileged
# @privileged holds @clock, and so the read of the clock's error bound: allowed back, every system
# call that read may be (glibc's adjtimex(3) is clock_adjtime(2), and clock_adjtime64 on a 32-bit
# time_t; tally_wire::kernel_clock::SYSCALLS, which //crates/feed:unit holds this line to).
SystemCallFilter=adjtimex clock_adjtime clock_adjtime64
# A refused call fails with EPERM rather than killing the process: a feeder refused its clock's
# bound treats the host as unsynced, which is no clock source at all (as NTP never votes an
# undisciplined local clock): it signs by its configured relays, or by the host's clock as read
# while none is selected.
SystemCallErrorNumber=EPERM
# It never listens: binding any socket is refused outright.
SocketBindDeny=any
MemoryMax=64M
CPUQuota=20%
TasksMax=64

[Install]
WantedBy=multi-user.target
