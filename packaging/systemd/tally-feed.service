# The Tally feeder (RFC-0171 §3.5): reads this receiver's own decoders and publishes what they heard
# to a few Tally relays. It only connects out: it listens on no port and takes no orders from the
# network. Its arguments are in /etc/default/tally-feed: TALLY_FEED_ARGS, the block install.sh
# rewrites on every run (the relays, the location and how exactly it is published, the UAT
# source), then TALLY_FEED_EXTRA, the owner's own flags, which install.sh keeps; a flag given once
# (--lat, --precision) is the last one's, so the owner's wins. `tally-feed --help` lists them.
#
# Needs systemd 247 or later (LoadCredential= and $CREDENTIALS_DIRECTORY, both new in 247; the %d
# specifier for the same directory is 248's, so it is not used). SocketBindDeny= is 249's: an
# older systemd logs that it does not know it and runs the unit without it, the feeder still
# opening no listening socket of its own.

# The feeder trusts its host's clock as a reference only while the host's ClockBound daemon
# (/var/run/clockbound/shm0) says it is Synchronized within 7.5 s (RFC-0171 §3.6). It never needs
# ClockBound, and install.sh installs none: without it, or while it says anything else, the host
# is simply no reference, and the feeder signs by its configured relays' clocks. So the unit is
# ordered after clockbound.service, where a host has it, and never pulls it in. The kernel's own
# bound (adjtimex's maxerror) is not read: it cannot say which daemon wrote it.

[Unit]
Description=Tally feeder: publishes this receiver's receptions to Tally relays
Documentation=https://github.com/sky-commons/tally
After=network-online.target clockbound.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/tally-feed
# The key stays root's, mode 600. systemd reads it and hands the service a private copy in its
# credentials directory ($CREDENTIALS_DIRECTORY), so the dynamic user never needs access to
# /etc/tally. ${NAME} is one word and $NAME splits on whitespace, an unset one giving none.
LoadCredential=key:/etc/tally/key
ExecStart=/usr/local/bin/tally-feed --key ${CREDENTIALS_DIRECTORY}/key --state /var/lib/tally-feed $TALLY_FEED_ARGS $TALLY_FEED_EXTRA
Restart=always
RestartSec=10

DynamicUser=yes
StateDirectory=tally-feed
StateDirectoryMode=0700
ConfigurationDirectory=tally
UMask=0077

# A small, outbound-only process: it may connect to the decoders and to relays, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No PrivateDevices=, which would hide /dev/vmclock0: ClockBound's client reads it beside the
# segment where the hypervisor offers one (systemd.exec(5): "When access to some but not all
# devices must be possible, the DeviceAllow= setting might be used instead"). Every other device
# stays closed. On a host with no VM clock systemd logs that it cannot stat /dev/vmclock0 as the
# unit starts: harmless, the rule then allows nothing and the unit runs.
DevicePolicy=closed
DeviceAllow=/dev/vmclock0 r
# PrivateDevices= gave the process a /dev/shm of its own; without it the host's is shared, so it
# is made private here (systemd.exec(5), TemporaryFileSystem=), as PrivateDevices= mounted it.
TemporaryFileSystem=/dev/shm:mode=1777,nosuid,nodev,noexec
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Nothing here reads or sets the clock's discipline: the bound is ClockBound's, read from shared
# memory, so every call that could set the clock is filtered too.
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# @resources stays allowed: the async runtime may set a thread's affinity or priority.
SystemCallFilter=~@privileged
# A refused call fails with EPERM rather than killing the process with SIGSYS unsaid.
SystemCallErrorNumber=EPERM
# It never listens: binding any socket is refused outright.
SocketBindDeny=any
MemoryMax=64M
CPUQuota=20%
TasksMax=64

[Install]
WantedBy=multi-user.target
