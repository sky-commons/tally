# The Tally feeder (RFC-0166 §3.5): reads this receiver's own decoders and publishes what they heard
# to a few Tally relays. It only connects out: it listens on no port and takes no orders from the
# network. Its arguments (location, the UAT source, a home relay) are the owner's, in
# /etc/default/tally-feed as TALLY_FEED_ARGS; `tally-feed --help` lists them.
#
# Needs systemd 248 or later (LoadCredential and the %d specifier).

[Unit]
Description=Tally feeder: publishes this receiver's receptions to Tally relays
Documentation=https://github.com/flightlines/tally
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/tally-feed
# The key stays root's, mode 600. systemd reads it and hands the service a private copy in its
# credentials directory (%d), so the dynamic user never needs access to /etc/tally.
LoadCredential=key:/etc/tally/key
ExecStart=/usr/local/bin/tally-feed --key %d/key --state /var/lib/tally-feed $TALLY_FEED_ARGS
Restart=always
RestartSec=10

DynamicUser=yes
StateDirectory=tally-feed
StateDirectoryMode=0700
ConfigurationDirectory=tally
UMask=0077

# A small, outbound-only process: it may connect to the decoders and to relays, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# It never listens: binding any socket is refused outright.
SocketBindDeny=any
MemoryMax=64M
CPUQuota=20%
TasksMax=64

[Install]
WantedBy=multi-user.target
