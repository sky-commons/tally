# A Tally relay (RFC-0171 §3.6): accepts feeders, subscribers and other relays on one port, checks
# each batch's signature and forwards it. Its arguments (where it listens, its upstreams, how many
# subscribers it serves) are the operator's, in /etc/default/tally-relay as TALLY_RELAY_ARGS;
# `tally-relay --help` lists them.
#
# The key is made once with `tally-relay keygen > /etc/tally/relay.key` (as root, umask 077). During
# a key rotation, add the new key in a drop-in (`systemctl edit tally-relay`) as a second
# LoadCredential and `--key %d/<name>` in TALLY_RELAY_ARGS, newest first.
#
# The most the relay sends a second to billed peers is TALLY_RELAY_MAX_UPLOAD (tally/README.md,
# "What a relay costs"). It bounds the bill: the relay never sends more than this rate times the
# seconds in a month. The default below is deliberately small, so a relay nobody configured cannot
# run up a bill: 2Mbit/s is at most about 670 GB in 31 days. The operator must set it for this
# host's plan in /etc/default/tally-relay, for example TALLY_RELAY_MAX_UPLOAD=6Mbit/s on a $12
# Lightsail plan (at most about 2.01 TB in 31 days, leaving about 1 TB of its 3 TB for what feeders
# send in, which counts toward it too; 10Mbit/s would be up to about 3.35 TB out alone). The cap keeps
# no state.
#
# Needs systemd 248 or later (LoadCredential and the %d specifier).

[Unit]
Description=Tally relay: verifies and forwards Tally receivers' batches
Documentation=https://github.com/sky-commons/tally
# A relay judges what it compares across machines by the host's wall clock as its time daemon
# keeps it, with the kernel's error bound, and times every duration by the monotonic clock
# (RFC-0171 §3.6). A step of the wall clock ends nothing: the relay tells its feeders the new time.
# Until the host first reports its clock synchronised, and whenever the kernel's error bound on it
# (which grows from its last sync) is past 7.5 s, the relay states its error as unbounded and
# refuses no one for clock, so it can start before the clock is set, but it judges best once it is.
# The host's time daemon must be chrony or ntpd: each sets the kernel's error bound (maxerror) to
# its root distance, the bound against true time the relay judges by. systemd-timesyncd sets it to
# 0 at every adjustment (src/timesync/timesyncd-manager.c, manager_adjust_clock), and the kernel
# grows it 500 us a second from there, so the bound counts only the drift since its last poll,
# never the server's own distance or the measurement's error, and a relay could judge by a clock
# seconds off while it reads milliseconds; nothing stock tells that bound from chrony's, so the
# relay cannot refuse it and the requirement is stated here.
# The relay starts after chrony-wait.service (chrony's own wait for a synchronised clock, pulled in
# when chrony is installed), and after time-sync.target, which it never pulls in
# (systemd.special(7): a unit that needs the time is ordered after it "but not pull it in"). That
# target holds the start back only while a wait service is enabled (under ntpd, ntpsec-wait.service
# or systemd-time-wait-sync.service); with none it is reached at once, and what holds is the
# kernel's word read at each judgement, as above.
After=network-online.target chrony-wait.service time-sync.target
Wants=network-online.target chrony-wait.service

[Service]
Type=simple
# The operator must set this for their host; /etc/default/tally-relay overrides it. 2Mbit/s bounds
# the bill at about 670 GB a month.
Environment=TALLY_RELAY_MAX_UPLOAD=2Mbit/s
EnvironmentFile=/etc/default/tally-relay
# The key stays root's, mode 600; the service gets a private copy in its credentials directory.
LoadCredential=key:/etc/tally/relay.key
ExecStart=/usr/local/bin/tally-relay --key %d/key --max-upload ${TALLY_RELAY_MAX_UPLOAD} $TALLY_RELAY_ARGS
Restart=always
RestartSec=5

DynamicUser=yes
ConfigurationDirectory=tally
# What survives a restart (RFC-0171 §3.6): each strike table's lease on the newest time it may have
# used, and on a graceful stop the fingerprints it holds, so a restarted relay forwards nothing
# twice and a deploy is not deaf: /var/lib/tally-relay, kept across restarts with DynamicUser and
# found through $STATE_DIRECTORY, which systemd sets from this line.
StateDirectory=tally-relay
UMask=0077
# One descriptor per connection its caps admit: those under --max-connections (2048), the member
# sessions its areas bring (up to as many), the subscribers (64) and beast-out clients (8), every
# feeder the budget admits, the stats' 16 and 256 for the process itself (`Hub::descriptors`).
# `tally-relay check` prints the sum as `descriptors`: 2,931 in this unit's 6G as packaged, 4,594
# with a base cell taken and beast-out on, about 25,000 at 64G. The relay raises its own soft limit
# to that at start and refuses to start when this hard limit is below it, so 65536 runs a relay
# of well over 100G (//crates/relay:check holds this unit to its plan).
LimitNOFILE=65536
# A relay under memory pressure is throttled past MemoryHigh and, past MemoryMax, killed by the
# kernel's OOM killer inside its own cgroup and restarted (Restart=always), rather than taking the
# host down with it. The relay's budget is MemoryHigh less its headroom: 64 MiB and a quarter of
# the plan for the allocator's free pages (`budget::headroom_for`); 6G holds every member session a
# base cell brings (the 2,048 the default connection cap allows, each with its kernel socket
# buffers, its link's and an engine's place) and feeders beside them (`tally-relay check`, held by
# //crates/relay:check). 4G held them only while those buffers were planned nowhere.
MemoryHigh=6G
MemoryMax=7G

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# No ProtectClock=: it filters adjtimex(2) whole, and the relay reads the clock's error bound with
# it (a read, no modes set). The clock cannot be set from here all the same: the empty
# CapabilityBoundingSet below keeps CAP_SYS_TIME out, and the kernel refuses a write without it.
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# The default port (10900) and --beast-out need no privilege to bind.
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# @resources stays allowed: the async runtime may set a thread's affinity or priority.
SystemCallFilter=~@privileged
# @privileged holds @clock, and so the read of the clock's error bound: allowed back, every system
# call that read may be (glibc's adjtimex(3) is clock_adjtime(2), and clock_adjtime64 on a 32-bit
# time_t; tally_wire::kernel_clock::SYSCALLS, which //crates/relay:check holds this line to). With
# no capability it can change nothing.
SystemCallFilter=adjtimex clock_adjtime clock_adjtime64
# A refused call fails with EPERM rather than killing the process, so a relay the filter still
# refuses its clock says so and stops (clock::kernel_answers) instead of dying of SIGSYS unsaid.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
