# The packaged units. //crates/relay:check holds the relay's to its memory budget, through
# `tally-relay check` (RFC-0181 §9), and to how it reads the clock's bound from ClockBound
# (`tally_wire::clock_bound::unit_faults`).
exports_files(
    ["tally-relay.service"],
    visibility = ["//crates/relay:__pkg__"],
)

# The feeder's: //crates/feed:unit holds it to the same read of ClockBound; and the updater's
# (RFC-0203), which //packaging:upgrade_test installs with it.
exports_files(
    ["tally-feed.service"],
    visibility = [
        "//crates/feed:__pkg__",
        "//packaging:__pkg__",
    ],
)

exports_files(
    [
        "tally-feed-update.service",
        "tally-feed-update.timer",
    ],
    visibility = ["//packaging:__pkg__"],
)
