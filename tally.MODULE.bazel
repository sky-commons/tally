# Tally's third-party crates (RFC-0171 §3.10), resolved by crate_universe from the workspace's own
# Cargo.toml and Cargo.lock; MODULE.bazel includes this file.

tally_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
tally_host_tools.host_tools(
    name = "tally_rust_host_tools",
    version = "1.96.0",
)
use_repo(tally_host_tools, "tally_rust_host_tools")

tally_crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
tally_crate.from_cargo(
    name = "tally_crates",
    cargo_lockfile = "//:Cargo.lock",
    host_tools = "@tally_rust_host_tools",
    manifests = ["//:Cargo.toml"],
    # Cargo.lock is cargo's own: resolution fails rather than rewriting it.
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf",
        "aarch64-apple-darwin",
    ],
)

# BLAKE2s is on the MLAT's hot path (every reception's identity, every ranking and thinning hash),
# and unoptimised it costs the solver's tests ten times their time: optimised in every build, as
# tally's Cargo.toml does (`[profile.dev.package.blake2]`).
tally_crate.annotation(
    crate = "blake2",
    repositories = ["tally_crates"],
    rustc_flags = ["-Copt-level=2"],
)
use_repo(tally_crate, "tally_crates")
