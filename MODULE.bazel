# Tally's module (RFC-0171 §3.10, RFC-0180). It builds with Bazel alone: the toolchains, the C
# library it links against and every crate are pinned below and in tally.MODULE.bazel.

module(name = "tally")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    # A feeder runs on a Raspberry Pi: aarch64 is a release target beside the host's, and armv7
    # hard-float for 32-bit Raspberry Pi OS and the PiAware image (the feeder only).
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf",
    ],
    versions = ["1.96.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# A pinned C toolchain and C library for linking, so the build needs nothing installed beyond
# Bazel: LLVM, and Chromium's Debian bullseye sysroots (glibc 2.31, so the binaries also run on
# older Raspberry Pi OS). Hashes from Chromium's build/linux/sysroot_scripts/sysroots.json. A call
# into the C library past what this sysroot offers fails the link; such calls live in
# crates/relay/src/os.rs.
bazel_dep(name = "toolchains_llvm", version = "1.9.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# What compiling and linking read: headers and libraries. (The rest of the image includes systemd
# unit names with a backslash, which no Bazel label may carry.)
_SYSROOT_BUILD = """filegroup(
    name = "sysroot",
    srcs = glob(
        ["lib/**", "lib64/**", "usr/include/**", "usr/lib/**"],
        exclude = ["lib/systemd/**", "usr/lib/systemd/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
"""

http_archive(
    name = "sysroot_linux_x86_64",
    build_file_content = _SYSROOT_BUILD,
    sha256 = "52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d",
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d"],
)

# Chromium's bullseye_armhf, glibc 2.31 like the others: for the 32-bit ARM feeder.
http_archive(
    name = "sysroot_linux_armv7",
    build_file_content = _SYSROOT_BUILD,
    sha256 = "d78a9e2739dd4cce413dc8629ad0be840591c6456f9a4c6ed4b29ecf2a4257f3",
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/d78a9e2739dd4cce413dc8629ad0be840591c6456f9a4c6ed4b29ecf2a4257f3"],
)

http_archive(
    name = "sysroot_linux_aarch64",
    build_file_content = _SYSROOT_BUILD,
    sha256 = "c7176a4c7aacbf46bda58a029f39f79a68008d3dee6518f154dcf5161a5486d8",
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/c7176a4c7aacbf46bda58a029f39f79a68008d3dee6518f154dcf5161a5486d8"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "22.1.8",
    # The ARM sysroots carry only a shared libstdc++. Tally is Rust and uses no C++, so with
    # --as-needed the binaries do not end up depending on it.
    stdlib = {
        "linux-aarch64": "dynamic-stdc++",
        "linux-armv7": "dynamic-stdc++",
    },
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:sysroot",
    targets = ["linux-aarch64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_armv7//:sysroot",
    targets = ["linux-armv7"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

include("//:tally.MODULE.bazel")
